<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ p.name }} Portfolio</title>
<link rel="stylesheet" href="{{ fonts_css }}">
<style>
@page { size: 297mm 210mm; margin: 0; }
:root {
  --bg: #11161e; --bg-raise: #171e28; --bg-sunk: #0c1016; --line: #243041; --line-strong: #34425a;
  --fg: #e3e8ef; --fg-2: #a3adbd; --fg-3: #6e7a8d;
  --mint: #7dd6bc; --amber: #edc07a; --lilac: #b3a6f2; --sky: #86beea; --coral: #ee9580; --device: #07090d;
  --display: "Martian Mono", ui-monospace, monospace; --body: "Geist", system-ui, sans-serif; --code: "JetBrains Mono", ui-monospace, monospace;
}
* { box-sizing: border-box; }
html, body { margin: 0; background: var(--bg); color: var(--fg); }
body { font-family: var(--body); font-size: 9.6pt; line-height: 1.5; -webkit-print-color-adjust: exact; print-color-adjust: exact; font-feature-settings: "ss01" on; }
p { margin: 0; }
a { color: inherit; text-decoration: none; }
.pg { width: 297mm; height: 210mm; position: relative; overflow: hidden; break-after: page; background: var(--bg); padding: 12mm 16mm 11mm; display: flex; flex-direction: column; gap: 7mm; }
.pg:last-child { break-after: auto; }
.top { display: flex; justify-content: space-between; align-items: center; font-family: var(--code); font-size: 8pt; color: var(--fg-3); position: relative; z-index: 2; }
.top b { color: var(--sky); font-weight: 500; }
.body { flex: 1; min-height: 0; position: relative; z-index: 1; }
.path { font-family: var(--code); font-size: 8.5pt; color: var(--fg-3); }
.path b { color: var(--sky); font-weight: 500; }
h1, h2, h3 { margin: 0; text-wrap: balance; }
h2 { font-family: var(--display); font-weight: 400; font-size: 21pt; line-height: 1.12; letter-spacing: -0.04em; font-variation-settings: "wdth" 90; }
h3 { font-size: 21pt; font-weight: 560; letter-spacing: -0.025em; line-height: 1.12; }
.lede { color: var(--fg-2); font-size: 11pt; line-height: 1.5; }
.muted { color: var(--fg-2); }
.status { --c: var(--fg-2); display: inline-flex; align-items: center; gap: 2mm; font-size: 8pt; font-weight: 500; color: var(--c); padding: 1.2mm 2.6mm; border-radius: 99px; border: 0.6pt solid color-mix(in oklab, var(--c) 40%, transparent); background: color-mix(in oklab, var(--c) 12%, transparent); line-height: 1; }
.status::before { content: ""; width: 1.7mm; height: 1.7mm; border-radius: 50%; background: var(--c); }
.status[data-status="live"] { --c: var(--mint); } .status[data-status="active"] { --c: var(--sky); } .status[data-status="build"] { --c: var(--amber); } .status[data-status="testing"] { --c: var(--lilac); }
.meta { display: flex; flex-wrap: wrap; align-items: center; gap: 2mm 4mm; font-size: 8.6pt; color: var(--fg-3); }
.chips { display: flex; flex-wrap: wrap; gap: 1.6mm; }
.chips span { font-family: var(--code); font-size: 7.6pt; color: var(--fg-2); padding: 0.9mm 2mm; border: 0.6pt solid var(--line); border-radius: 1.4mm; background: var(--bg-raise); }
.facts { display: flex; flex-wrap: wrap; gap: 1.6mm; }
.facts span { font-size: 8.2pt; color: var(--fg); padding: 1mm 2.4mm; border-radius: 1.6mm; background: color-mix(in oklab, var(--amber) 10%, transparent); border: 0.6pt solid color-mix(in oklab, var(--amber) 26%, transparent); }
.browser { border-radius: 2.6mm; overflow: hidden; background: var(--bg-raise); border: 0.6pt solid var(--line); box-shadow: 0 6mm 14mm -6mm rgba(0, 0, 0, 0.7); }
.browser .bar { height: 6mm; display: flex; align-items: center; gap: 1.3mm; padding: 0 3mm; border-bottom: 0.6pt solid var(--line); }
.browser .bar i { width: 1.8mm; height: 1.8mm; border-radius: 50%; background: var(--line-strong); }
.browser .bar span { margin-left: 2mm; font-family: var(--code); font-size: 6.8pt; color: var(--fg-3); }
.browser img { display: block; width: 100%; }
.phone { border-radius: 5mm; overflow: hidden; background: var(--device); border: 1.3mm solid var(--device); box-shadow: 0 0 0 0.4pt #2a3445, 0 6mm 14mm -6mm rgba(0, 0, 0, 0.75); }
.phone img { display: block; width: 100%; border-radius: 3.6mm; }
.cap { font-size: 7.8pt; color: var(--fg-3); margin-top: 2mm; }

/* cover */
.cover .art { position: absolute; right: -52mm; top: -4mm; width: 196mm; height: 192mm; object-fit: cover; object-position: 40% 50%; z-index: 0; }
.cover .body { display: flex; flex-direction: column; justify-content: center; gap: 7mm; max-width: 132mm; }
.hello { display: flex; align-items: center; gap: 3.4mm; font-size: 9.6pt; color: var(--fg-2); line-height: 1.35; }
.hello img { width: 12mm; height: 12mm; border-radius: 50%; object-fit: cover; object-position: 50% 20%; box-shadow: 0 0 0 0.8mm var(--bg), 0 0 0 1.1mm color-mix(in oklab, var(--mint) 70%, transparent); }
.hello b { color: var(--fg); font-weight: 500; }
.cover h1 { white-space: nowrap; font-family: var(--display); font-weight: 380; font-size: 35pt; line-height: 1.03; letter-spacing: -0.05em; font-variation-settings: "wdth" 84; }
.contact { display: grid; grid-template-columns: auto 1fr; gap: 1.2mm 5mm; font-family: var(--code); font-size: 8.6pt; color: var(--fg-2); }
.contact span:nth-child(odd) { color: var(--fg-3); }
.sbar { display: grid; grid-template-columns: auto repeat(4, 1fr); border: 0.6pt solid var(--line); border-radius: 2.6mm; background: color-mix(in oklab, var(--bg-raise) 88%, transparent); font-family: var(--code); font-size: 7.6pt; color: var(--fg-2); position: relative; z-index: 2; }
.sbar > div { padding: 3mm 4mm; border-right: 0.6pt solid var(--line); line-height: 1.4; }
.sbar > div:last-child { border-right: 0; }
.sbar .br { color: var(--mint); display: flex; align-items: center; }
.sbar b { display: block; font-family: var(--display); font-weight: 500; font-size: 15pt; color: var(--amber); letter-spacing: -0.04em; line-height: 1.2; }

/* readme */
.readme { display: grid; grid-template-columns: 82mm 1fr; gap: 12mm; height: 100%; }
.portrait { border-radius: 3.4mm; overflow: hidden; border: 0.6pt solid var(--line); background: var(--bg-raise); align-self: start; }
.portrait .file { display: flex; justify-content: space-between; padding: 2mm 3mm; font-family: var(--code); font-size: 7pt; color: var(--fg-3); border-bottom: 0.6pt solid var(--line); }
.portrait img { display: block; width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }
.readme-copy { display: flex; flex-direction: column; gap: 4mm; }
.readme-copy .intro { color: var(--fg); font-size: 11pt; line-height: 1.5; }
.readme-copy p { color: var(--fg-2); }
.princ { display: grid; grid-template-columns: 1fr 1fr; gap: 0 8mm; margin-top: 2mm; }
.princ div { border-top: 0.6pt solid var(--line); padding: 3mm 0 3.4mm; }
.princ .fn { font-family: var(--code); font-size: 8pt; color: var(--lilac); }
.princ h4 { margin: 1mm 0 1mm; font-size: 10.6pt; font-weight: 600; }
.princ p { font-size: 8.8pt; line-height: 1.45; }

/* career */
.career { display: grid; grid-template-columns: 1fr 88mm; gap: 12mm; height: 100%; }
.git { margin: 4mm 0 0; padding: 0; list-style: none; }
.git li { display: grid; grid-template-columns: 15mm 1fr; min-height: 11.4mm; }
.git .g { position: relative; }
.git .lane { position: absolute; top: 0; bottom: 0; width: 0.5mm; }
.git .l1 { left: 3.6mm; background: color-mix(in oklab, var(--sky) 55%, var(--line-strong)); }
.git .l2 { left: 9.6mm; background: color-mix(in oklab, var(--lilac) 65%, var(--line-strong)); }
.git .from { top: 4.6mm; } .git .to { bottom: auto; height: 4.6mm; }
.git .dot { position: absolute; top: 3.1mm; width: 3.4mm; height: 3.4mm; border-radius: 50%; background: var(--bg); border: 0.5mm solid var(--sky); z-index: 1; }
.git .d1 { left: 2.1mm; } .git .d2 { left: 8.1mm; border-color: var(--lilac); }
.git .head .dot { background: var(--sky); }
.git .fork { position: absolute; left: 0; bottom: 0; width: 15mm; height: calc(100% - 4.6mm); }
.git .fork path { fill: none; stroke: color-mix(in oklab, var(--lilac) 65%, var(--line-strong)); stroke-width: 0.5mm; }
.git .t { padding: 2mm 0 1.6mm; }
.git .l { font-family: var(--code); font-size: 7.6pt; display: flex; gap: 2mm; flex-wrap: wrap; }
.git .h { color: var(--amber); } .git .r { color: var(--mint); } .git .ty { color: var(--lilac); }
.git .m { font-size: 9.2pt; color: var(--fg); line-height: 1.35; }
.git .w { font-family: var(--code); font-size: 7pt; color: var(--fg-3); }
.roles { display: flex; flex-direction: column; gap: 4mm; }
.roles .role { border: 0.6pt solid var(--line); border-radius: 2.6mm; background: var(--bg-raise); padding: 4mm; }
.roles .when { font-family: var(--code); font-size: 7.8pt; color: var(--amber); }
.roles h4 { margin: 1mm 0 0.6mm; font-size: 10.8pt; font-weight: 600; }
.roles .org { font-size: 8.6pt; color: var(--fg-3); }
.roles p.s { margin-top: 2mm; font-size: 8.6pt; color: var(--fg-2); line-height: 1.45; }

/* stack */
.stackpg { display: grid; grid-template-columns: 1fr 120mm; gap: 8mm; height: 100%; }
.layers { margin-top: 5mm; display: flex; flex-direction: column; }
.layer { border-top: 0.6pt solid var(--line); padding: 2.8mm 0 3mm 4mm; position: relative; }
.layer:last-child { border-bottom: 0.6pt solid var(--line); }
.layer::before { content: ""; position: absolute; left: 0; top: 4.2mm; width: 1.6mm; height: 1.6mm; border-radius: 0.4mm; background: var(--c); }
.layer .hd { display: flex; justify-content: space-between; gap: 4mm; align-items: baseline; margin-bottom: 1.6mm; }
.layer b { font-size: 10pt; font-weight: 600; }
.layer .wh { font-size: 7.8pt; color: var(--fg-3); }
.stackpg .art { width: 100%; height: 100%; object-fit: cover; object-position: 50% 52%; }

/* index */
.idx { margin-top: 5mm; display: flex; flex-direction: column; }
.idx .row { display: grid; grid-template-columns: 30mm 1fr 50mm 58mm 9mm; gap: 6mm; align-items: center; padding: 3.2mm 0; border-top: 0.6pt solid var(--line); }
.idx .row:last-child { border-bottom: 0.6pt solid var(--line); }
.idx .nm { font-size: 11pt; font-weight: 600; letter-spacing: -0.01em; }
.idx .ol { font-size: 8.6pt; color: var(--fg-2); margin-top: 0.6mm; }
.idx .co { font-size: 8.6pt; color: var(--fg-2); line-height: 1.4; }
.idx .co span { display: block; color: var(--fg-3); font-size: 7.8pt; }
.idx .pn { font-family: var(--code); font-size: 8pt; color: var(--fg-3); text-align: right; }

/* project pages */
.proj { display: grid; grid-template-columns: 96mm 1fr; gap: 11mm; height: 100%; }
.proj-copy { display: flex; flex-direction: column; gap: 3.6mm; }
.blocks { display: flex; flex-direction: column; gap: 3mm; margin-top: 1mm; }
.blocks h5 { margin: 0 0 0.6mm; font-size: 8.2pt; font-weight: 600; }
.blocks .b { color: var(--sky); } .blocks .t { color: var(--lilac); }
.blocks p { font-size: 8.9pt; color: var(--fg-2); line-height: 1.48; }
.proj-media { display: flex; flex-direction: column; justify-content: center; gap: 4mm; min-width: 0; }
.media-wrap { position: relative; }
.media-wrap .phone { position: absolute; right: 0; bottom: -8mm; width: 28%; }
.media-wrap.has-phone { padding-right: 17%; padding-bottom: 6mm; }
.arch { display: flex; align-items: stretch; gap: 0; margin-top: 2mm; }
.arch .n { flex: 1; border: 0.6pt solid var(--line-strong); border-radius: 2mm; padding: 2.4mm 2.6mm; background: var(--bg-raise); }
.arch .n b { display: block; font-family: var(--code); font-size: 7.6pt; color: var(--c, var(--fg)); font-weight: 500; }
.arch .n span { display: block; font-size: 7.4pt; color: var(--fg-2); line-height: 1.35; margin-top: 0.8mm; }
.arch .a { width: 7mm; display: grid; place-items: center; color: var(--fg-3); font-family: var(--code); font-size: 9pt; }

/* contact */
.closing { display: grid; grid-template-columns: 1fr 112mm; gap: 8mm; height: 100%; align-items: center; }
.closing h2 { font-size: 34pt; line-height: 1.04; letter-spacing: -0.05em; }
.closing .list { margin-top: 7mm; display: grid; grid-template-columns: 30mm 1fr; border-top: 0.6pt solid var(--line); }
.closing .list span { padding: 2.6mm 0; border-bottom: 0.6pt solid var(--line); font-size: 10pt; }
.closing .list span:nth-child(odd) { color: var(--fg-3); }
.closing .art { width: 100%; height: 150mm; object-fit: contain; object-position: 60% 50%; }
</style>
</head>
<body>

{# ---------------------------------------------------------------- cover #}
<section class="pg cover">
  <img class="art" src="{{ img('scene0-dark.png') }}" alt="">
  <div class="top"><span>~/ali/<b>portfolio.pdf</b></span><span>November 2026</span></div>
  <div class="body">
    <p class="hello"><img src="{{ img('headshot-square-dark.jpg') }}" alt=""><span><b>{{ p.name }}</b><br>{{ p.headline }}</span></p>
    <h1>Full-stack,<br>all the way down.</h1>
    <p class="lede">{{ p.intro }}</p>
    <div class="contact">
      <span>email</span><span>{{ p.email }}</span>
      <span>phone</span><span>{{ p.phone }}</span>
      <span>github</span><span>{{ p.github }}</span>
      <span>linkedin</span><span>{{ p.linkedin }}</span>
      <span>status</span><span>{{ p.availability }}</span>
    </div>
  </div>
  <div class="sbar">
    <div class="br">main</div>
    {% for s in stats %}<div><b>{{ s.value }}</b>{{ s.label }}</div>{% endfor %}
  </div>
</section>

{# ---------------------------------------------------------------- readme #}
<section class="pg">
  <div class="top"><span>~/ali/<b>README.md</b></span><span>02 / {{ total }}</span></div>
  <div class="body readme">
    <div class="portrait"><div class="file"><span>ali.jpg</span><span>1200 × 1600</span></div><img src="{{ img('headshot-dark.jpg') }}" alt="Portrait of {{ p.name }}"></div>
    <div class="readme-copy">
      <h2>Networks first, then everything that runs on them</h2>
      <p class="intro">{{ p.about_long[0] }}</p>
      <p>{{ p.about_long[1] }}</p>
      <div class="princ">
        {% for pr in d.principles %}<div><p class="fn">{{ pr.key }}</p><h4>{{ pr.title }}</h4><p>{{ pr.body }}</p></div>{% endfor %}
      </div>
      <p class="muted" style="font-size:8.8pt">{{ d.education.degree }}, {{ d.education.school }} ({{ d.education.dates }}, {{ d.education.note }}). Arabic native, English professional.</p>
    </div>
  </div>
</section>

{# ---------------------------------------------------------------- career #}
<section class="pg">
  <div class="top"><span>~/ali $ <b>git log --graph --all</b></span><span>03 / {{ total }}</span></div>
  <div class="body career">
    <div>
      <h2>Career, as a commit history</h2>
      <ol class="git">
        {% for c in gitrows %}
        <li class="{{ 'head' if c.is_head else '' }}">
          <div class="g">
            {% if c.l1 %}<span class="lane l1 {{ c.l1 }}"></span>{% endif %}
            {% if c.l2 %}<span class="lane l2 {{ c.l2 }}"></span>{% endif %}
            {% if c.fork %}<svg class="fork" viewBox="0 0 57 40" preserveAspectRatio="none"><path d="M38 0 C38 22, 15 18, 15 40" vector-effect="non-scaling-stroke"/></svg>{% endif %}
            <span class="dot {{ 'd2' if c.branch == 'awam' else 'd1' }}"></span>
          </div>
          <div class="t">
            <p class="l"><span class="h">{{ c.hash }}</span>{% if c.ref %}<span class="r">({{ 'HEAD -> main' if c.ref.startswith('HEAD') else c.ref }})</span>{% endif %}<span class="ty">{{ c.type }}{% if c.scope %}({{ c.scope }}){% endif %}:</span><span class="w">{{ c.date if c.date else 'status: ' ~ c.tag }}</span></p>
            <p class="m">{{ c.msg }}</p>
          </div>
        </li>
        {% endfor %}
      </ol>
    </div>
    <div class="roles">
      {% for e in d.experience %}
      <div class="role">
        <p class="when">{{ e.dates }}</p>
        <h4>{{ e.role }}</h4>
        <p class="org">{{ e.org }}. {% if e.org_note %}{{ e.org_note }}. {% endif %}{{ e.place }}.</p>
        <p class="s">{{ e.bullets[0] }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{# ---------------------------------------------------------------- stack #}
<section class="pg">
  <div class="top"><span>~/ali/<b>architecture</b></span><span>04 / {{ total }}</span></div>
  <div class="body stackpg">
    <div>
      <h2>Every layer, one owner</h2>
      <p class="lede" style="margin-top:3mm">The tools I use in production, from the network up to the interface, and the systems where each one runs today.</p>
      <div class="layers">
        {% for l in layers %}
        <div class="layer" style="--c: var(--{{ l.c }})"><div class="hd"><b>{{ l.name }}</b><span class="wh">{{ l.where }}</span></div><div class="chips">{% for t in l.tech %}<span>{{ t }}</span>{% endfor %}</div></div>
        {% endfor %}
      </div>
    </div>
    <img class="art" src="{{ img('scene2-dark.png') }}" alt="">
  </div>
</section>

{# ---------------------------------------------------------------- index #}
<section class="pg">
  <div class="top"><span>~/ali/<b>work</b></span><span>05 / {{ total }}</span></div>
  <div class="body">
    <h2>Eight systems, four companies, one technical owner</h2>
    <p class="lede" style="margin-top:3mm;max-width:190mm">Production work across a holding group and my own practice. Client repositories stay private under NDA; I am happy to walk through any of them live.</p>
    <div class="idx">
      {% for pr in d.projects %}
      <div class="row">
        <div><span class="status" data-status="{{ pr.status_key }}">{{ pr.status }}</span></div>
        <div><p class="nm">{{ pr.name }}</p><p class="ol">{{ pr.oneliner }}</p></div>
        <p class="co">{{ pr.company }}<span>{{ pr.country }}</span></p>
        <div class="chips">{% for t in pr.stack[:4] %}<span>{{ t }}</span>{% endfor %}</div>
        <p class="pn">p.{{ '%02d' % pr.page }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{# ---------------------------------------------------------------- HS Investment, two pages #}
{% set f = featured %}
<section class="pg">
  <div class="top"><span>~/ali/work/<b>{{ f.id }}</b></span><span>{{ '%02d' % f.page }} / {{ total }}</span></div>
  <div class="body proj">
    <div class="proj-copy">
      <div class="meta"><span class="status" data-status="{{ f.status_key }}">{{ f.status }}</span><span>{{ f.company }}</span><span>{{ f.country }}</span></div>
      <h3>{{ f.name }}</h3>
      <p class="lede">{{ f.oneliner }}</p>
      <p class="muted" style="font-size:8.8pt">Role: {{ f.role|lower }}. {{ f.kind }}.</p>
      <div class="blocks">
        <div><h5 class="b">Business challenge</h5><p>{{ f.business_challenge }}</p></div>
        <div><h5 class="b">Business solution</h5><p>{{ f.business_solution }}</p></div>
      </div>
      <div class="facts">{% for x in f.facts %}<span>{{ x }}</span>{% endfor %}</div>
    </div>
    <div class="proj-media">
      <div class="browser"><div class="bar"><i></i><i></i><i></i><span>localhost:3000</span></div><img src="{{ img(f.images[0].src ~ '.jpg') }}" alt="{{ f.images[0].alt }}"></div>
      <p class="cap">Public site: full-screen hero with scroll-driven motion and a static fallback for reduced motion.</p>
    </div>
  </div>
</section>
<section class="pg">
  <div class="top"><span>~/ali/work/<b>{{ f.id }}</b>/admin</span><span>{{ '%02d' % (f.page + 1) }} / {{ total }}</span></div>
  <div class="body proj">
    <div class="proj-copy">
      <div class="meta"><span class="status" data-status="{{ f.status_key }}">{{ f.status }}</span><span>Admin console</span></div>
      <h3>The console that runs it</h3>
      <div class="blocks">
        <div><h5 class="t">Technical challenge</h5><p>{{ f.technical_challenge }}</p></div>
        <div><h5 class="t">Technical solution</h5><p>{{ f.technical_solution }}</p></div>
      </div>
      <div class="chips">{% for t in f.stack %}<span>{{ t }}</span>{% endfor %}</div>
    </div>
    <div class="proj-media">
      <div class="browser"><div class="bar"><i></i><i></i><i></i><span>localhost:8000/admin</span></div><img src="{{ img(f.images[1].src ~ '.jpg') }}" alt="{{ f.images[1].alt }}"></div>
      <div class="arch">
        <div class="n" style="--c: var(--fg)"><b>Editors</b><span>HS Investment team</span></div><div class="a">→</div>
        <div class="n" style="--c: var(--lilac)"><b>Unfold admin</b><span>approvals, enquiries, media upload</span></div><div class="a">→</div>
        <div class="n" style="--c: var(--amber)"><b>Django 5.2</b><span>sectors, partnerships, opportunities</span></div><div class="a">→</div>
        <div class="n" style="--c: var(--sky)"><b>DRF API</b><span>read-only /api/</span></div><div class="a">→</div>
        <div class="n" style="--c: var(--mint)"><b>Next.js 16</b><span>public site, Framer Motion</span></div>
      </div>
      <p class="cap">Admin dashboard. The investor's name on the latest enquiry is blurred.</p>
    </div>
  </div>
</section>

{# ---------------------------------------------------------------- other projects #}
{% for pr in others %}
{% set web = pr.images|rejectattr('phone')|list %}
{% set mob = pr.images|selectattr('phone')|list %}
<section class="pg">
  <div class="top"><span>~/ali/work/<b>{{ pr.id }}</b></span><span>{{ '%02d' % pr.page }} / {{ total }}</span></div>
  <div class="body proj">
    <div class="proj-copy">
      <div class="meta"><span class="status" data-status="{{ pr.status_key }}">{{ pr.status }}</span><span>{{ pr.company }}</span><span>{{ pr.country }}</span></div>
      <h3>{{ pr.name }}</h3>
      <p class="lede">{{ pr.oneliner }}</p>
      <div class="blocks">
        <div><h5 class="b">Business challenge</h5><p>{{ pr.business_challenge }}</p></div>
        <div><h5 class="t">Technical challenge</h5><p>{{ pr.technical_challenge }}</p></div>
        <div><h5 class="b">Business solution</h5><p>{{ pr.business_solution }}</p></div>
        <div><h5 class="t">Technical solution</h5><p>{{ pr.technical_solution }}</p></div>
      </div>
    </div>
    <div class="proj-media">
      <div class="media-wrap{% if mob %} has-phone{% endif %}">
        {% if web %}<div class="browser"><div class="bar"><i></i><i></i><i></i><span>{{ pr.bar }}</span></div><img src="{{ img(web[0].src ~ '.jpg') }}" alt="{{ web[0].alt }}"></div>{% endif %}
        {% if mob %}<div class="phone"><img src="{{ img(mob[0].src ~ '.jpg') }}" alt="{{ mob[0].alt }}"></div>{% endif %}
      </div>
      <div class="facts" style="margin-top:{{ '8mm' if mob else '2mm' }}">{% for x in pr.facts %}<span>{{ x }}</span>{% endfor %}</div>
      <div class="chips">{% for t in pr.stack %}<span>{{ t }}</span>{% endfor %}{% if pr.url %}<span style="color:var(--mint)">{{ pr.url_label }}</span>{% endif %}</div>
      <p class="cap">Role: {{ pr.role|lower }}. {% if pr.url %}Live at {{ pr.url_label }}.{% else %}Private repository, walkthrough on request.{% endif %}</p>
    </div>
  </div>
</section>
{% endfor %}

{# ---------------------------------------------------------------- contact #}
<section class="pg">
  <div class="top"><span>~/ali $ <b>./contact.sh</b></span><span>{{ total }} / {{ total }}</span></div>
  <div class="body closing">
    <div>
      <h2>Let's build something that ships.</h2>
      <p class="lede" style="margin-top:5mm;max-width:130mm">I'm looking for a senior full-stack role, remote or with relocation. Email is the fastest way to reach me; I usually answer within a day.</p>
      <div class="list">
        <span>Email</span><span>{{ p.email }}</span>
        <span>Phone</span><span>{{ p.phone }}</span>
        <span>GitHub</span><span>{{ p.github }}</span>
        <span>LinkedIn</span><span>{{ p.linkedin }}</span>
        <span>Based in</span><span>{{ p.location }} ({{ p.timezone }})</span>
      </div>
    </div>
    <img class="art" src="{{ img('scene3-dark.png') }}" alt="">
  </div>
</section>

</body>
</html>
