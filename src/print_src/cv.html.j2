<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ p.name }} CV</title>
<link rel="stylesheet" href="{{ fonts_css }}">
<style>
@page { size: A4; margin: 14mm 16mm 13mm; }
:root {
  --ink: #152030; --ink-2: #3f4b5c; --ink-3: #6a7688; --line: #d9dfe7; --paper: #ffffff; --wash: #f2f5f8;
  --accent: #0d7760; --accent-2: #1b66a8; --num: #965c00;
  --display: "Martian Mono", ui-monospace, monospace; --body: "Geist", system-ui, sans-serif; --code: "JetBrains Mono", ui-monospace, monospace;
}
* { box-sizing: border-box; }
html, body { margin: 0; background: var(--paper); color: var(--ink); }
body { font-family: var(--body); font-size: 9.45pt; line-height: 1.47; -webkit-print-color-adjust: exact; print-color-adjust: exact; font-feature-settings: "ss01" on; }
.page { padding: 1mm 0 0; }
a { color: inherit; text-decoration: none; }
header { display: grid; grid-template-columns: {% if photo %}31mm {% endif %}1fr; gap: 7mm; align-items: center; padding-bottom: 6mm; border-bottom: 1.2pt solid var(--ink); }
header img { width: 31mm; height: 31mm; border-radius: 4mm; object-fit: cover; object-position: 50% 18%; display: block; }
h1 { margin: 0; font-family: var(--display); font-weight: 400; font-size: 23pt; letter-spacing: -0.045em; line-height: 1.05; }
.role { margin: 1.6mm 0 0; font-size: 11.5pt; font-weight: 600; color: var(--accent); letter-spacing: -0.01em; }
.contact { margin: 3mm 0 0; display: flex; flex-wrap: wrap; gap: 1.2mm 5.5mm; font-size: 8.8pt; color: var(--ink-2); }
.contact span b { font-weight: 500; color: var(--ink-3); margin-right: 1.2mm; }
h2 { margin: 6.2mm 0 2.6mm; font-family: var(--display); font-weight: 500; font-size: 10.5pt; letter-spacing: -0.02em; color: var(--ink); display: flex; align-items: center; gap: 3mm; }
h2::after { content: ""; flex: 1; height: 0.6pt; background: var(--line); }
p { margin: 0; }
.summary { color: var(--ink-2); font-size: 9.6pt; line-height: 1.5; }
.stats { display: flex; gap: 0; margin-top: 3.4mm; border: 0.6pt solid var(--line); border-radius: 2mm; }
.stats div { flex: 1; padding: 2.2mm 3mm; border-right: 0.6pt solid var(--line); font-size: 8.2pt; color: var(--ink-2); line-height: 1.3; }
.stats div:last-child { border-right: 0; }
.stats b { display: block; font-family: var(--display); font-weight: 500; font-size: 12.5pt; color: var(--num); letter-spacing: -0.04em; }
.skills { display: grid; gap: 1.5mm; }
.skills p { display: grid; grid-template-columns: 26mm 1fr; gap: 3mm; }
.skills b { font-weight: 600; color: var(--ink); }
.skills span { color: var(--ink-2); }
.job { margin-bottom: 4.6mm; }
.job-head { break-after: avoid-page; }
li { break-inside: avoid-page; }
.job-head { display: flex; justify-content: space-between; align-items: baseline; gap: 6mm; }
.job-head h3 { margin: 0; font-size: 10.4pt; font-weight: 600; letter-spacing: -0.01em; }
.job-head h3 span { font-weight: 400; color: var(--ink-2); }
.job-head .when { font-family: var(--code); font-size: 8.4pt; color: var(--ink-2); white-space: nowrap; }
.job .note { font-size: 8.6pt; color: var(--ink-3); margin-top: 0.4mm; }
ul { margin: 1.8mm 0 0; padding-left: 4.2mm; }
li { margin: 0 0 1.3mm; color: var(--ink-2); padding-left: 0.6mm; }
li::marker { color: var(--accent); }
.proj { display: grid; gap: 1.8mm; }
.proj p { display: grid; grid-template-columns: 56mm 1fr; gap: 3mm; break-inside: avoid-page; }
.proj b { font-weight: 600; }
.proj .st { display: block; font-family: var(--code); font-size: 7.6pt; color: var(--ink-3); font-weight: 400; }
.proj span { color: var(--ink-2); }
.two { display: grid; grid-template-columns: 1fr 1fr; gap: 8mm; }
.foot { margin-top: 5mm; padding-top: 3mm; border-top: 0.6pt solid var(--line); font-size: 8pt; color: var(--ink-3); display: flex; justify-content: space-between; gap: 6mm; }
.keep { break-inside: avoid-page; }
.code { font-family: var(--code); font-size: 0.92em; }
</style>
</head>
<body>
<div class="page">
  <header>
    {% if photo %}<img src="{{ photo }}" alt="Photo of {{ p.name }}">{% endif %}
    <div>
      <h1>{{ p.name }}</h1>
      <p class="role">{{ p.headline }}</p>
      <p class="contact">
        <span><b>Email</b><a href="mailto:{{ p.email }}">{{ p.email }}</a></span>
        <span><b>Phone</b>{{ p.phone }}</span>
        <span><b>Location</b>{{ p.location }}, open to remote or relocation</span>
        <span><b>GitHub</b><a href="{{ p.github_url }}">{{ p.github }}</a></span>
        <span><b>LinkedIn</b><a href="{{ p.linkedin_url }}">{{ p.linkedin }}</a></span>
      </p>
    </div>
  </header>

  <h2>Summary</h2>
  <p class="summary">{{ p.summary }}</p>
  <div class="stats">
    {% for s in stats %}<div><b>{{ s.value }}</b>{{ s.label }}</div>{% endfor %}
  </div>

  <h2>Skills</h2>
  <div class="skills">
    {% for g in skills %}<p><b>{{ g.group }}</b><span>{{ g['items']|join(', ') }}</span></p>{% endfor %}
  </div>

  <h2>Experience</h2>
  {% for e in experience %}
  <section class="job">
    <div class="job-head"><h3>{{ e.role }} <span>| {{ e.org }}</span></h3><span class="when">{{ e.dates }} | {{ e.place }}</span></div>
    {% if e.org_note %}<p class="note">{{ e.org_note }}</p>{% endif %}
    <ul>{% for b in e.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
  </section>
  {% endfor %}

  <section class="keep">
    <h2>Projects</h2>
    <div class="proj">
      {% for pr in projects %}
      <p><b>{{ pr.name }}<span class="st">{{ pr.status }} | {{ pr.company }}{% if pr.url %} | {{ pr.url_label }}{% endif %}</span></b><span>{{ pr.oneliner }} <span class="code">{{ pr.stack|join(', ') }}</span></span></p>
      {% endfor %}
    </div>
  </section>

  <div class="two keep">
    <section>
      <h2>Education</h2>
      <p><b>{{ edu.degree }}</b></p>
      <p style="color:var(--ink-2)">{{ edu.school }}, {{ edu.dates }}. {{ edu.note }}.</p>
    </section>
    <section>
      <h2>Languages</h2>
      {% for l in languages %}<p><b>{{ l.name }}</b> <span style="color:var(--ink-2)">{{ l.level }}</span></p>{% endfor %}
    </section>
  </div>

  <div class="foot"><span>Portfolio with case studies and screenshots available as a separate PDF.</span><span>Updated November 2026</span></div>
</div>
</body>
</html>
