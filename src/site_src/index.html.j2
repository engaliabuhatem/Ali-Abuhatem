<title>{{ page_title }}</title>
<meta name="claude:viewport-fit-sides" content="cover">
<meta name="description" content="{{ p.name }}: {{ p.headline }} in {{ p.location }}. Python, Django, Django REST Framework, PostgreSQL, Next.js, React, TypeScript, Flutter and Firebase. Open to senior full-stack roles, remote or relocation.">
<meta name="keywords" content="{{ keywords }}">
<meta name="author" content="{{ p.name }}">
<meta name="theme-color" content="#11161e">
<meta property="og:type" content="profile">
<meta property="og:title" content="{{ p.name }}, {{ p.headline }}">
<meta property="og:description" content="{{ p.intro }}">
{% if og_image %}<meta property="og:image" content="{{ og_image }}">
<meta name="twitter:card" content="summary_large_image">{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=JetBrains+Mono:wght@400;500&family=Martian+Mono:wdth,wght@75..112.5,300..600&display=swap">
<script type="application/ld+json">{{ jsonld|safe }}</script>
<style>
{{ css|safe }}
</style>

<a class="skip" href="#main">Skip to content</a>
<div class="cursor" aria-hidden="true"></div>

<header class="nav" id="top">
  <div class="wrap">
    <a class="brand" href="#top" aria-label="{{ p.name }}, back to top">
      <span class="brand-mark" aria-hidden="true">ah</span>
      <span class="brand-path" aria-hidden="true">~/ali<span class="seg" data-crumb></span><span class="caret"></span></span>
    </a>
    <ul class="nav-links">
      <li><a href="#work" data-scramble-hover>Work</a></li>
      <li><a href="#stack" data-scramble-hover>Stack</a></li>
      <li><a href="#career" data-scramble-hover>Career</a></li>
      <li><a href="#terminal" data-scramble-hover>Terminal</a></li>
      <li><a href="#contact" data-scramble-hover>Contact</a></li>
    </ul>
    <div class="nav-actions">
      <button class="icon-btn" type="button" id="theme-toggle" aria-label="Switch colour theme">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5Z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a class="btn btn-small btn-primary btn-cv" href="assets/{{ files.cv }}" data-download="{{ files.cv }}" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14"/></svg>
        CV
      </a>
      <button class="icon-btn nav-menu-btn" type="button" id="menu-btn" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <svg class="i-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
        <svg class="i-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
  </div>

</header>
<nav class="mobile-menu" id="mobile-menu" aria-label="Mobile">
    <a href="#work">Work</a>
    <a href="#stack">Stack</a>
    <a href="#career">Career</a>
    <a href="#terminal">Terminal</a>
    <a href="#contact">Contact</a>
    <a class="btn btn-primary" href="assets/{{ files.cv }}" data-download="{{ files.cv }}" target="_blank" rel="noopener">Download CV (PDF)</a>
  </nav>

<main id="main">
  <!-- ============ HERO ============ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hello">
            <span class="avatar"><img src="assets/headshot-square-dark.webp" width="600" height="600" alt=""></span>
            <span><b style="color:var(--fg);font-weight:500">{{ p.name }}</b><br>{{ p.short_title }} &amp; Technical Lead</span>
          </p>
          <h1 id="hero-title" data-hero-title>
            <span class="line"><span>Full-stack,</span></span>
            <span class="line"><span>all the way down.</span></span>
          </h1>
          <p class="lede">{{ p.intro }}</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#work" data-magnetic>See selected work</a>
            <a class="btn" href="assets/{{ files.cv }}" data-download="{{ files.cv }}" target="_blank" rel="noopener" data-magnetic>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14"/></svg>
              Download CV
            </a>
          </div>
          <p class="hero-meta">
            <span><i class="live-dot"></i>{{ p.availability }}</span>
            <span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
              {{ p.location }} ({{ p.timezone }})
            </span>
          </p>
        </div>
        <div class="hero-visual">
          <div class="hero-fallback" aria-hidden="true"></div>
          <div class="hero-canvas" id="hero-canvas" aria-hidden="true"></div>
          <div class="scene-nav">
            <div class="scene-tabs" role="tablist" aria-label="3D scene">
              {% for s in scenes %}<button type="button" role="tab" aria-selected="{{ 'true' if loop.first else 'false' }}" data-scene="{{ loop.index0 }}">{{ s.fn }}<span class="bar"></span></button>{% endfor %}
            </div>
            <p class="scene-caption" id="scene-caption" aria-live="polite">{{ scenes[0].caption }}</p>
          </div>
        </div>
      </div>

      <div class="statusbar" aria-label="Key figures">
        <span class="sb-branch">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="5" r="2"/><circle cx="6" cy="19" r="2"/><circle cx="18" cy="8" r="2"/><path d="M6 7v10M18 10c0 4-6 3.5-11.2 7.6"/></svg>
          main
        </span>
        {% for s in stats %}<span><b data-count="{{ s.value }}">{{ s.value }}</b><span>{{ s.label }}</span></span>{% endfor %}
      </div>
    </div>
  </section>

  <!-- ============ README ============ -->
  <section class="section" id="about" aria-labelledby="about-title" data-crumb="/readme">
    <div class="wrap">
      <div class="readme-grid">
        <div class="readme-copy">
          <p class="path code">~/ali/<b>README.md</b></p>
          <h2 id="about-title" data-scramble>Networks first, then everything that runs on them</h2>
          {% for para in p.about_long %}<p{% if loop.first %} class="intro"{% endif %}>{{ para }}</p>{% endfor %}
          <div class="editor" aria-label="Profile as a TypeScript object">
            <div class="editor-tabs" aria-hidden="true"><span class="on">about.ts</span><span>stack.json</span><span>ali.jpg</span></div>
            <pre><code>{{ about_code|safe }}</code></pre>
          </div>
        </div>
        <figure class="portrait" style="margin:0">
          <div class="portrait-card" data-tilt="8">
            <div class="file"><span><b>ali.jpg</b></span><span>1200 × 1600</span></div>
            <div class="portrait-img">
              <img class="ph-dark" src="assets/headshot-dark.webp" width="900" height="1200" alt="Portrait of {{ p.name }}">
              <img class="ph-light" src="assets/headshot-light.webp" width="900" height="1200" alt="" loading="lazy">
              <div class="grid-fx"></div>
              <div class="scan" data-scan></div>
            </div>
            <div class="glare"></div>
          </div>
          <div class="orbit" aria-hidden="true">
            <div class="orbit-ring">
              {% for o in orbit %}<span style="--a: {{ o.a }}deg"><i style="--c: var(--{{ o.c }})">{{ o.t }}</i></span>{% endfor %}
            </div>
          </div>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============ PRINCIPLES ============ -->
  <section class="section" style="padding-top:0" aria-labelledby="principles-title" data-crumb="/principles">
    <div class="wrap">
      <div class="section-head">
        <p class="path code">~/ali/<b>principles.ts</b></p>
        <h2 id="principles-title" data-scramble>How I build</h2>
      </div>
      <div class="principles">
        {% for pr in d.principles %}
        <article class="principle">
          <p class="fn">{{ pr.key }}</p>
          <h3>{{ pr.title }}</h3>
          <p>{{ pr.body }}</p>
          <p class="proof">Seen in: <b>{{ pr.proof }}</b></p>
        </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ============ WORK ============ -->
  <section class="section" id="work" aria-labelledby="work-title" data-crumb="/work" style="padding-top:clamp(40px,6vw,80px)">
    <div class="wrap">
      <div class="section-head">
        <p class="path code">~/ali/<b>work</b></p>
        <h2 id="work-title" data-scramble>Seven systems, four companies, one technical owner</h2>
        <p class="lede">Production work across a holding group and my own practice. Client repositories stay private under NDA; I am happy to walk through any of them live.</p>
      </div>

      {% set f = featured %}
      <article class="featured" id="project-{{ f.id }}">
        <div class="featured-copy">
          <div class="meta-row"><span class="status" data-status="{{ f.status_key }}">{{ f.status }}</span><span>{{ f.company }}</span><span>{{ f.kind }}</span></div>
          <h3>{{ f.name }}</h3>
          <p class="one">{{ f.oneliner }}</p>
          <p class="muted">{{ f.technical_solution }}</p>
          <ul class="facts">{% for x in f.facts %}<li>{{ x }}</li>{% endfor %}</ul>
          <ul class="stack-chips" aria-label="Stack">{% for t in f.stack %}<li>{{ t }}</li>{% endfor %}</ul>
          <div><button class="btn" type="button" data-open="case-{{ f.id }}">Read the case study</button></div>
        </div>
        <div class="featured-media">
          <div class="screens" data-screens>
            <div class="screen browser front" data-screen="0">
              <div class="bar"><i></i><i></i><i></i><span class="url">localhost:3000</span></div>
              <img src="assets/{{ f.images[0].src }}.webp" width="1600" height="863" alt="{{ f.images[0].alt }}">
            </div>
            <div class="screen browser back" data-screen="1">
              <div class="bar"><i></i><i></i><i></i><span class="url">localhost:8000/admin</span></div>
              <img src="assets/{{ f.images[1].src }}.webp" width="1600" height="862" alt="{{ f.images[1].alt }}" loading="lazy">
            </div>
          </div>
          <div class="screen-switch" role="tablist" aria-label="Show screen">
            <button type="button" role="tab" aria-selected="true" data-show="0">Public site</button>
            <button type="button" role="tab" aria-selected="false" data-show="1">Admin console</button>
          </div>
        </div>
      </article>

      <div class="work-grid">
        {% for pr in others %}
        {% set web = pr.images|rejectattr('phone')|list %}
        {% set mob = pr.images|selectattr('phone')|list %}
        <article class="tile" id="project-{{ pr.id }}">
          <div class="media{% if mob %} has-phone{% endif %}" data-tilt-wrap>
            <div class="tilt" data-tilt="6">
              {% if web %}
              <div class="browser">
                <div class="bar"><i></i><i></i><i></i><span class="url">{{ pr.bar }}</span></div>
                <img src="assets/{{ web[0].src }}.webp" width="1400" height="760" alt="{{ web[0].alt }}" loading="lazy" decoding="async">
              </div>
              {% endif %}
              {% if mob %}
              <div class="phone phone-float"><img src="assets/{{ mob[0].src }}.webp" width="620" height="1343" alt="{{ mob[0].alt }}" loading="lazy" decoding="async"></div>
              {% endif %}
            </div>
          </div>
          <div class="meta-row"><span class="status" data-status="{{ pr.status_key }}">{{ pr.status }}</span><span>{{ pr.company }}</span><span>{{ pr.country }}</span></div>
          <h3>{{ pr.name }}</h3>
          <p class="one">{{ pr.oneliner }}</p>
          <ul class="stack-chips" aria-label="Stack">{% for t in pr.stack %}<li>{{ t }}</li>{% endfor %}</ul>
          <div class="row">
            <button class="link-case" type="button" data-open="case-{{ pr.id }}">Read the case study</button>
            {% if pr.url %}<a class="ext" href="{{ pr.url }}" target="_blank" rel="noopener">{{ pr.url_label }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg><span class="sr-only">(opens in a new tab)</span></a>{% endif %}
          </div>
        </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ============ STACK ============ -->
  <section class="section" id="stack" aria-labelledby="stack-title" data-crumb="/stack">
    <div class="wrap stack-grid">
      <div>
        <div class="section-head" style="margin-bottom:0">
          <p class="path code">~/ali/<b>architecture</b></p>
          <h2 id="stack-title" data-scramble>Every layer, one owner</h2>
          <p class="lede">The tools I use in production, from the network up to the interface, and the systems where each one runs today.</p>
        </div>
        <ol class="layers">
          {% for l in layers %}
          <li class="layer" data-layer="{{ loop.index0 }}" style="--c: var(--{{ l.c }})" tabindex="0">
            <div class="layer-head"><span class="layer-name">{{ l.name }}</span><span class="layer-where">{{ l.where }}</span></div>
            <ul class="stack-chips">{% for t in l.tech %}<li>{{ t }}</li>{% endfor %}</ul>
          </li>
          {% endfor %}
        </ol>
      </div>
      <div class="stack-viz" aria-hidden="true">
        <div class="iso" data-iso>
          {% for l in layers %}<div class="plate" data-plate="{{ loop.index0 }}" style="--i: {{ loop.index0 }}; --c: var(--{{ l.c }})"><span>{{ l.short }}<small>{{ l.tech[0] }}</small></span></div>{% endfor %}
          <i class="packet" style="--x: 22%; --y: 30%; --d: 0s"></i>
          <i class="packet" style="--x: 68%; --y: 42%; --d: 1.1s"></i>
          <i class="packet" style="--x: 44%; --y: 70%; --d: 2.2s"></i>
          <i class="packet" style="--x: 78%; --y: 18%; --d: 2.9s"></i>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CAREER ============ -->
  <section class="section" id="career" aria-labelledby="career-title" data-crumb="/career">
    <div class="wrap">
      <div class="section-head">
        <p class="path code">~/ali $ <b>git log --graph --all</b></p>
        <h2 id="career-title" data-scramble>Career, as a commit history</h2>
      </div>
      <div class="career-cols">
        <div>
          <div class="gitlog-legend" aria-hidden="true">
            <span><i style="background:var(--sky)"></i>main: employment</span>
            <span><i style="background:var(--lilac)"></i>awam-soft: independent practice</span>
          </div>
          <ol class="gitlog" data-gitlog>
            {% for c in gitrows %}
            <li class="commit{% if c.is_head %} is-head{% endif %}{% if c.branch == 'awam' %} on-awam{% endif %}">
              <div class="graph" aria-hidden="true">
                {% if c.l1 %}<span class="lane l1{% if c.l1 == 'from' %} from-dot{% elif c.l1 == 'to' %} to-dot{% endif %}"></span>{% endif %}
                {% if c.l2 %}<span class="lane l2{% if c.l2 == 'from' %} from-dot{% elif c.l2 == 'to' %} to-dot{% endif %}"></span>{% endif %}
                {% if c.fork %}<svg class="fork" viewBox="0 0 72 40" preserveAspectRatio="none"><path d="M49 0 C49 22, 19 18, 19 40" vector-effect="non-scaling-stroke"/></svg>{% endif %}
                <span class="dot {{ 'on-l2' if c.branch == 'awam' else 'on-l1' }}"></span>
              </div>
              <div class="body">
                <p class="line1"><span class="hash">{{ c.hash }}</span>{% if c.ref %}<span class="ref">({% if c.ref.startswith('HEAD') %}<span class="head">HEAD</span> -&gt; main{% else %}{{ c.ref }}{% endif %})</span>{% endif %}<span class="type">{{ c.type }}{% if c.scope %}({{ c.scope }}){% endif %}:</span></p>
                <p class="msg">{{ c.msg }}</p>
                <p class="when">{% if c.date %}{{ c.date }}{% else %}status: {{ c.tag }}{% endif %}</p>
              </div>
            </li>
            {% endfor %}
          </ol>
        </div>
        <aside class="edu" aria-label="Education and languages">
          <div><h3>Education</h3><p>{{ d.education.degree }}</p><p class="sub">{{ d.education.school }}, {{ d.education.dates }}. {{ d.education.note }}.</p></div>
          <div><h3>Languages</h3>{% for l in d.languages %}<p>{{ l.name }} <span class="sub">({{ l.level|lower }})</span></p>{% endfor %}</div>
          <div><h3>Right now</h3><p class="sub">Technical Lead at HS Group since April 2024, and running AWAM SOFT in parallel since 2023.</p></div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ============ TERMINAL ============ -->
  <section class="section" id="terminal" aria-labelledby="terminal-title" data-crumb="/terminal">
    <div class="wrap term-wrap">
      <div class="section-head" style="margin-bottom:0">
        <p class="path code">~/ali/<b>terminal</b></p>
        <h2 id="terminal-title" data-scramble>Ask the terminal</h2>
        <p class="lede">The same profile, for people who prefer a prompt. Type <span class="code">help</span>, press Tab to complete, and use the arrow keys for history.</p>
      </div>
      <div>
        <div class="term" id="term">
          <div class="term-bar" aria-hidden="true"><i></i><i></i><i></i><span>guest@ali-abu-hatem: ~</span></div>
          <div class="term-out" id="term-out" role="log" aria-live="polite" tabindex="0"></div>
          <form class="term-in" id="term-form" autocomplete="off">
            <label class="prompt" for="term-input"><b>guest</b>@ali:~$</label>
            <input id="term-input" type="text" spellcheck="false" autocapitalize="off" aria-label="Terminal command">
          </form>
        </div>
        <div class="term-hints" aria-label="Suggested commands">
          {% for h in ['neofetch', 'whoami', 'projects', 'skills', 'experience', 'contact', 'sudo hire-ali'] %}<button type="button" data-cmd="{{ h }}">{{ h }}</button>{% endfor %}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section class="contact" id="contact" aria-labelledby="contact-title" data-crumb="/contact">
    <div class="wrap">
      <p class="path code" style="color:var(--fg-3);font-size:var(--t-sm);margin-bottom:22px">~/ali $ <b style="color:var(--sky);font-weight:500">./contact.sh</b></p>
      <h2 id="contact-title" data-scramble>Let's build something that ships.</h2>
      <p class="lede">I'm looking for a senior full-stack role, remote or with relocation. Email is the fastest way to reach me; I usually answer within a day.</p>
      <div class="contact-grid">
        <div>
          <div class="email-row">
            <a class="email" href="mailto:{{ p.email }}" id="email">{{ p.email }}</a>
            <button class="btn btn-small" type="button" id="copy-email" data-copy="{{ p.email }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg>
              Copy email
            </button>
          </div>
          <ul class="contact-list">
            <li><span>Phone</span><a href="tel:{{ p.phone_href }}">{{ p.phone }}</a></li>
            <li><span>GitHub</span><a href="{{ p.github_url }}" target="_blank" rel="noopener">{{ p.github }}</a></li>
            <li><span>LinkedIn</span><a href="{{ p.linkedin_url }}" target="_blank" rel="noopener">{{ p.linkedin }}</a></li>
            <li><span>Based in</span><span>{{ p.location }} ({{ p.timezone }})</span></li>
          </ul>
        </div>
        <div class="downloads">
          <h3>Take it with you</h3>
          <a class="btn btn-primary" href="assets/{{ files.cv }}" data-download="{{ files.cv }}" target="_blank" rel="noopener"><span>CV, 2 pages</span><small>PDF</small></a>
          <a class="btn" href="assets/{{ files.cv_ats }}" data-download="{{ files.cv_ats }}" target="_blank" rel="noopener"><span>CV without photo</span><small>PDF</small></a>
          <a class="btn" href="assets/{{ files.portfolio }}" data-download="{{ files.portfolio }}" target="_blank" rel="noopener"><span>Portfolio, case studies</span><small>PDF</small></a>
        </div>
      </div>
      <footer class="footer">
        <span>© 2026 {{ p.name }}. Designed and built by hand with Three.js and GSAP.</span>
        <span class="code">last commit: November 2026 · open the console for a note</span>
      </footer>
    </div>
  </section>
</main>

{% for pr in d.projects %}
<dialog class="case" id="case-{{ pr.id }}" aria-labelledby="case-{{ pr.id }}-title">
  <div class="case-head">
    <div>
      <div class="meta-row"><span class="status" data-status="{{ pr.status_key }}">{{ pr.status }}</span><span>{{ pr.client }}</span><span>{{ pr.country }}</span></div>
      <h3 id="case-{{ pr.id }}-title">{{ pr.name }}</h3>
      <p class="muted" style="margin-top:6px">{{ pr.kind }}. Role: {{ pr.role|lower }}.</p>
    </div>
    <button class="icon-btn" type="button" data-close aria-label="Close case study">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </div>
  <div class="case-body">
    <div class="case-gallery">
      {% for im in pr.images %}
      <figure class="{{ 'mob' if im.phone else 'web' }}">
        {% if im.phone %}<div class="phone"><img data-src="assets/{{ im.src }}.webp" width="620" height="1343" alt="{{ im.alt }}"></div>
        {% else %}<div class="browser"><div class="bar"><i></i><i></i><i></i></div><img data-src="assets/{{ im.src }}.webp" width="1400" height="760" alt="{{ im.alt }}"></div>{% endif %}
        <figcaption>{{ im.label }}</figcaption>
      </figure>
      {% endfor %}
    </div>
    <div class="case-grid">
      <div><h4 class="biz">Business challenge</h4><p>{{ pr.business_challenge }}</p></div>
      <div><h4 class="tech">Technical challenge</h4><p>{{ pr.technical_challenge }}</p></div>
      <div><h4 class="biz">Business solution</h4><p>{{ pr.business_solution }}</p></div>
      <div><h4 class="tech">Technical solution</h4><p>{{ pr.technical_solution }}</p></div>
    </div>
    <div class="case-foot">
      <ul class="stack-chips" aria-label="Stack">{% for t in pr.stack %}<li>{{ t }}</li>{% endfor %}</ul>
      {% if pr.url %}<a class="ext" href="{{ pr.url }}" target="_blank" rel="noopener">Visit {{ pr.url_label }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg></a>{% else %}<span class="muted" style="font-size:14px">Private repository. Walkthrough on request.</span>{% endif %}
    </div>
  </div>
</dialog>
{% endfor %}

<div class="toast" id="toast" role="status" aria-live="polite"></div>

